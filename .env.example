# Security
SECRET_KEY=django-insecure-expense-tracker-dev-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*

# Database: PostgreSQL (Set USE_POSTGRES=True to activate PostgreSQL)
USE_POSTGRES=False
DB_NAME=expense_tracker_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
